# OpenAI key for the /api/chat assistant and the student workspace helpers
# (check-in guidance, academic triage, call-proxy replies).
OPENAI_API_KEY=
# Optional override (defaults to gpt-4o-mini).
OPENAI_MODEL=

# Browser key restricted to your allowed HTTP referrers and the Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. Use a Maps JavaScript 3D map ID when you create one in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# Deepgram Voice Agent. The proxy creates a short-lived browser token; never expose
# the API key to browser code. A Member key is required to mint a temporary token.
DEEPGRAM_API_KEY=
DEEPGRAM_AGENT_ID=

# Canvas: personal access token and your institution's Canvas base URL.
CANVAS_BASE_URL=
CANVAS_ACCESS_TOKEN=
